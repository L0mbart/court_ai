<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CourtAI" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/court_orange</item>
        <item name="colorSecondary">@color/court_amber</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/court_ink</item>
        <item name="android:navigationBarColor">@color/court_ink</item>
        <item name="android:windowBackground">@color/court_ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Theme.CourtAI.Fullscreen" parent="Theme.CourtAI">
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="CourtCard">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="CourtButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/court_orange</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="CourtButton.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/court_line</item>
        <item name="android:textColor">@color/court_cream</item>
        <item name="cornerRadius">14dp</item>
    </style>
</resources>
